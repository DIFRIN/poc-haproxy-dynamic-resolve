# ============================================================================
# POC: HAProxy dynamic CONNECT vs Squid  —  one-datacenter reference topology
# ============================================================================
# Copy to `.env` before running `docker compose up -d`.
#
# ADDRESSING MODEL
# ----------------
# All POC nodes live on ONE Docker bridge network ("dc-lan"), which models the
# single L2 segment of a production datacenter. This is required: VRRP owns a
# floating VIP on that segment and clients must reach it by ARP, exactly as in
# production. See docs/adr/0005-keepalived-vrrp.md for why unicast VRRP is used
# and what that does and does not reproduce.
#
# NOTE ON SSRF: 172.28.0.0/24 is RFC1918, which TARGET's destination policy
# denies by default. The IoT endpoint range is therefore carried as an explicit
# exception inside the policy itself (the `!{ var(txn.dstip) -m ip
# ${IOT_MOCK_IP}/32 }` clause on each deny in haproxy/target/haproxy.cfg.tmpl).
# In production, IoT endpoints resolve to publicly routable addresses and no
# such exception is needed.
#
# CURRENT — read carefully before assuming it has equivalent protection: the
# real production Squid has NO destination validation at all and is an open
# forward proxy. See docs/adr/0028-production-config-fidelity.md.
#
# See docs/adr/README.md#22-destination-security-policy for the policy itself.
# ============================================================================

COMPOSE_PROJECT_NAME=poc-proxy

# --- DC LAN (models the datacenter L2 segment) ------------------------------
DC_LAN_SUBNET=172.28.0.0/24
DC_LAN_GW=172.28.0.1

# --- Floating VIP (exactly one per datacenter) ------------------------------
VIP_ADDRESS=172.28.0.10
# Prefix length the VIP is configured with on the node interface. Must match
# DC_LAN_SUBNET; Keepalived adds the address as a /24 on eth0.
VIP_PREFIX=24

# --- HAProxy node pair (active/passive, never active/active) ----------------
HAPROXY_1_IP=172.28.0.11
HAPROXY_2_IP=172.28.0.12

# --- CURRENT: common Squid layer (shared by whichever HAProxy is active) ----
SQUID_1_IP=172.28.0.21
SQUID_2_IP=172.28.0.22

# --- TARGET: dnsdist pair (local to each HAProxy node) ---------------------
DNSDIST_1_IP=172.28.0.31
DNSDIST_2_IP=172.28.0.32

# --- Authoritative DNS pair (identical data, PostgreSQL-backed) -------------
PDNS_1_IP=172.28.0.41
PDNS_2_IP=172.28.0.42

# --- Data + workload --------------------------------------------------------
POSTGRES_IP=172.28.0.50
IOT_MOCK_IP=172.28.0.60
CLIENT_IP=172.28.0.100

# --- Service ports ----------------------------------------------------------
# CURRENT has TWO ports, and production runs them on DIFFERENT numbers. The
# POC originally modelled a single PROXY_PORT used for both hops, which is a
# fidelity defect: it made the client-facing listener and the Squid listener
# the same number, and neither matched production.
#
#   client --CONNECT--> VIP:CLIENT_PORT --tcp relay--> squid:SQUID_PORT
#
# CLIENT_PORT — CURRENT's client-facing CONNECT listener.
#   PRODUCTION VALUE: 38888.  (frontend frontend_proxyhttp / bind :38888)
CLIENT_PORT=38888
# SQUID_PORT — Squid's listener, and the port HAProxy's proxyhttp backend
#   connects to. In production Squid takes this from the Ansible variable
#   role_squid_proxy_port, and HAProxy targets iode-squid-N-svc...:4443.
#   PRODUCTION VALUE: 4443.
SQUID_PORT=4443
# DNS service port inside the POC (53 is left free on the host).
DNS_PORT=53
# IoT Mock mTLS HTTPS listener. TARGET's client-facing port, and the CONNECT
# authority port, so the POC exercises the production HTTPS/443 path.
IOT_MOCK_PORT=443

# --- CURRENT HAProxy sizing — PRODUCTION VALUES -----------------------------
# These reproduce the production HAProxy's connection ceilings EXACTLY, so the
# POC measures the architecture that actually runs rather than an idealised
# one. Production's numbers are:
#
#   global   maxconn  10000
#   frontend maxconn   6400
#   backend  fullconn  6400
#   server   maxconn   3200   (x2 Squid)
#
# The binding constraint is the Squid pair: 2 x 3200 = 6400 concurrent
# tunnels, which is BELOW the 10,000 simultaneous tunnels that brief §15 makes
# mandatory. That gap is a finding, not a POC artefact — see
# docs/adr/0028-production-config-fidelity.md. The benchmark's
# "CURRENT resized" variant raises these to show what CURRENT would need in
# order to meet the requirement.
CURRENT_GLOBAL_MAXCONN=10000
CURRENT_FRONTEND_MAXCONN=6400
CURRENT_FULLCONN=6400
CURRENT_SERVER_MAXCONN=3200

# --- "CURRENT resized" variant ----------------------------------------------
# To answer "what would CURRENT need in order to meet brief §15's 10,000
# simultaneous tunnels?", raise the four values above and RECREATE the nodes:
#
#   CURRENT_GLOBAL_MAXCONN=40000
#   CURRENT_FRONTEND_MAXCONN=20000
#   CURRENT_FULLCONN=20000
#   CURRENT_SERVER_MAXCONN=10000     # 2 x 10000 = 20000 tunnels
#
#   docker compose up -d --force-recreate haproxy-1 haproxy-2
#
# The ceilings are applied when a node renders its config, so a running stack
# keeps the sizing it started with. benchmark/run.sh derives its result labels
# from these values, so a resized run is written as `<arch>-resized-...` and
# cannot be mistaken for production sizing. Restore the values above afterwards.

# --- CURRENT Squid access-control model -------------------------------------
# squid.conf           the REAL production ACLs, reproduced verbatim. Measured
#                      consequence: Squid is an OPEN FORWARD PROXY with no
#                      destination validation whatsoever. See ADR 28.
# squid.conf.hardened  counterfactual. The resolved-address destination policy
#                      this POC originally — and wrongly — attributed to
#                      production. Kept so the "what if CURRENT were hardened?"
#                      comparison survives, clearly labelled as hypothetical.
SQUID_CONF=squid.conf

# --- HAProxy stats credentials ----------------------------------------------
# Production configures `stats auth` with an EMPTY username. HAProxy accepts
# that, but it is a config smell, so the POC uses a named user. The stats
# listener is loopback-bound either way.
STATS_USER=admin
STATS_PASSWORD=poc-stats-password

# --- DNS namespace ----------------------------------------------------------
DNS_ZONE=test.domain
DNS_RECORD_COUNT=1000000

# --- Credentials (POC only — never reuse outside this lab) ------------------
POSTGRES_DB=pdns
POSTGRES_USER=pdns
POSTGRES_PASSWORD=pdns_poc_password
PDNS_API_KEY=poc-pdns-api-key
PDNS_ALSO_NOTIFY=no
